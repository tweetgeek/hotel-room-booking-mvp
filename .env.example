# MariaDB connection (docker-compose.yml defaults)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=hotel
DB_PASSWORD=hotel
# Development database; integration and E2E tests use DB_TEST_NAME instead
DB_NAME=hotel
DB_TEST_NAME=hotel_test

# Redis connection; cache and access tokens live in separate logical databases
# so a projection rebuild can flush the cache without logging guests out
REDIS_URL=redis://127.0.0.1:6380
REDIS_CACHE_DB=0
REDIS_ACCESS_DB=1

# Shared secret used to sign payment webhooks (HMAC-SHA256)
WEBHOOK_SECRET=change-me-local-only

# Where the payment operator simulator delivers webhooks
API_BASE_URL=http://localhost:3100
PORT=3100

# How long a reservation may wait for the payment decision before it expires
PENDING_PAYMENT_TTL_MINUTES=15

# Frontend: API origin; use the computer's LAN address to open the app on a phone
VITE_API_URL=http://localhost:3100
